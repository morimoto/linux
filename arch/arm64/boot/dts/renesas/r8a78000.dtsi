		usb31: usb@c9c58000 {
			compatible = "renesas,rcar-gen5-usb";
			reg = <0 0xc9c58000 0 0x2000>;
			#address-cells = <2>;
			#size-cells = <2>;
			/* CRITICAL FIX: Proper address translation */
