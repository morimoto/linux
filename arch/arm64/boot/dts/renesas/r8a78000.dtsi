			// resets = <&cpg RSW3_RST>;

			status = "disabled";
		};

		eth_pcs: phy@c9c50000 {
			compatible = "renesas,r8a78000-ether-pcs";
			reg = <0 0xc9c50000 0 0x4000>;
			#phy-cells = <1>;
			power-domains = <&scmi_devpd 19>; /* R8A78000_SCMI_PD_MPP2 */
			clocks = <&scmi_clk 312>, /* R8A78000_SCMI_CLOCK_MDLC_XPCS0 */
				 <&scmi_clk 313>, /* R8A78000_SCMI_CLOCK_MDLC_XPCS1 */
				 <&scmi_clk 314>, /* R8A78000_SCMI_CLOCK_MDLC_XPCS2 */
				 <&scmi_clk 315>, /* R8A78000_SCMI_CLOCK_MDLC_XPCS3 */
				 <&scmi_clk 316>, /* R8A78000_SCMI_CLOCK_MDLC_XPCS4 */
				 <&scmi_clk 317>, /* R8A78000_SCMI_CLOCK_MDLC_XPCS5 */
				 <&scmi_clk 318>, /* R8A78000_SCMI_CLOCK_MDLC_XPCS6 */
				 <&scmi_clk 319>; /* R8A78000_SCMI_CLOCK_MDLC_XPCS7 */
			clock-names = "xpcs0", "xpcs1", "xpcs2", "xpcs3",
				      "xpcs4", "xpcs5", "xpcs6", "xpcs7";
			resets = <&scmi_reset 312>, /* R8A78000_SCMI_RESET_XPCS0 */
				 <&scmi_reset 313>, /* R8A78000_SCMI_RESET_XPCS1 */
				 <&scmi_reset 314>, /* R8A78000_SCMI_RESET_XPCS2 */
				 <&scmi_reset 315>, /* R8A78000_SCMI_RESET_XPCS3 */
				 <&scmi_reset 316>, /* R8A78000_SCMI_RESET_XPCS4 */
				 <&scmi_reset 317>, /* R8A78000_SCMI_RESET_XPCS5 */
				 <&scmi_reset 318>, /* R8A78000_SCMI_RESET_XPCS6 */
				 <&scmi_reset 319>; /* R8A78000_SCMI_RESET_XPCS7 */
			reset-names = "pcs0", "pcs1", "pcs2", "pcs3",
				      "pcs4", "pcs5", "pcs6", "pcs7";
			status = "disabled";
		};

		tsnes3: ethernet@c9c6c000 {
			compatible = "renesas,r8a78000-ethertsn";
			reg = <0 0xc9c6c000 0 0x4000>,
				  <0 0xc9ca3000 0 0x800>;
			reg-names = "tsnes", "gptp";
			interrupts = <GIC_SPI 853 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 854 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 855 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 856 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 857 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "status", "tx", "rx", "ts", "error";
			power-domains = <&scmi_devpd 15>; /* R8A78000_SCMI_PD_RSW */
			clocks = <&scmi_clk 321>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3TSN */
				 <&scmi_clk 326>; /* R8A78000_SCMI_CLOCK_MDLC_RSW3TSNTES3 */
			clock-names = "rsw3tsn", "tsnes";
			renesas,gptp-domain = "a";
			phy-mode = "gmii";
			max-speed = <2500>;
			renesas,tsnes-id = <3>;
			renesas,rswitch = <&rswitch3>;
			renesas,rswitch-if = <8>;
			renesas,rswitch-forward-ports = <4>;
			status = "disabled";
			fixed-link {
				speed = <2500>;
				full-duplex;
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 12 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "sec-phys", "phys", "virt", "hyp-phys", "hyp-virt";
	};

	ufs1_ref_clk: ufs1-ref-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};
};
