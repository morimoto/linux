			clocks = <&cpg R8A78000_CPG_SGASYNCD16_PERW_BUS>,
				 <&cpg R8A78000_CPG_SGASYNCD4_PERW_BUS>,
				 <&scif_clk>;
			clock-names = "fck", "brg_int", "scif_clk";
			power-domains = <&mdlc_perw R8A78000_MDLC_PD_APL 0x40>;
