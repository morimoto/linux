				 <&scif_clk>;
			clock-names = "fck", "brg_int", "scif_clk";
			power-domains = <&mdlc_perw R8A78000_MDLC_PD_APL 0x43>;
			resets = <&mdlc_perw 0x43>;
			status = "disabled";
		};

