				 <GIC_SPI 827 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 828 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 829 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 830 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 831 IRQ_TYPE_LEVEL_HIGH>,
