				 <GIC_SPI 846 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 847 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 848 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 849 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 850 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 851 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 852 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 853 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 854 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 855 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 856 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 857 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 858 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 859 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 860 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 861 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 862 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 863 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 864 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 865 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 866 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 867 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 868 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 869 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 870 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 871 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 872 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 873 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 874 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 875 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 876 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 877 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 878 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 879 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 880 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 881 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 882 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 883 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 884 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 885 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 886 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 887 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 888 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 889 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 890 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 891 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names =
				"race_wrap_mfwd_int", "race_wrap_race_int",
				"race_wrap_coma_int", "race_wrap_gwca0_int",
				"race_wrap_gwca1_int", "race_wrap_etha0_int",
				"race_wrap_etha1_int", "race_wrap_etha2_int",
				"race_wrap_etha3_int", "race_wrap_etha4_int",
				"race_wrap_etha5_int", "race_wrap_etha6_int",
				"race_wrap_etha7_int", "race_wrap_etha8_int",
				"race_wrap_etha9_int", "race_wrap_etha10_int",
				"race_wrap_etha11_int", "race_wrap_etha12_int",
				"race_wrap_gwca0_gwdis_int0", "race_wrap_gwca0_gwdis_int1",
				"race_wrap_gwca0_gwdis_int2", "race_wrap_gwca0_gwdis_int3",
				"race_wrap_gwca0_gwdis_int4", "race_wrap_gwca0_gwdis_int5",
				"race_wrap_gwca0_gwdis_int6", "race_wrap_gwca0_gwdis_int7",
				"gwca1_gwdis0", "gwca1_gwdis1", "gwca1_gwdis2", "gwca1_gwdis3",
				"gwca1_gwdis4", "gwca1_gwdis5", "gwca1_gwdis6", "gwca1_gwdis7",
				"race_wrap_gwca0_gwtsdis_int0", "race_wrap_gwca0_gwtsdis_int1",
				"race_wrap_gwca1_gwtsdis_int0", "race_wrap_gwca1_gwtsdis_int1",
				"race_wrap_gptp_int",
				"tes0_status_int", "tes0_tx_int", "tes0_rx_int", "tes0_ts_int",
				"tes0_error_int", "tes1_status_int", "tes1_tx_int",
				"tes1_rx_int", "tes1_ts_int", "tes1_error_int",
				"tes2_status_int", "tes2_tx_int", "tes2_rx_int",
				"tes2_ts_int", "tes2_error_int", "tes3_status_int",
				"tes3_tx_int", "tes3_rx_int", "tes3_ts_int", "tes3_error_int",
				"tes4_status_int", "tes4_tx_int", "tes4_rx_int", "tes4_ts_int",
				"tes4_error_int", "tes5_status_int", "tes5_tx_int",
				"tes5_rx_int", "tes5_ts_int", "tes5_error_int",
				"tes6_status_int", "tes6_tx_int", "tes6_rx_int",
				"tes6_ts_int", "tes6_error_int", "tes7_status_int",
				"tes7_tx_int", "tes7_rx_int", "tes7_ts_int", "tes7_error_int",
				"tes0_gptp_int", "tes1_gptp_int", "tes2_gptp_int",
				"tes3_gptp_int", "tes4_gptp_int", "tes5_gptp_int",
				"tes6_gptp_int", "tes7_gptp_int",
				"race_wrap_msc0_error_int", "race_wrap_msc1_error_int",
				"race_wrap_msc2_error_int", "race_wrap_msc3_error_int",
				"race_wrap_msc4_error_int", "race_wrap_msc5_error_int",
				"race_wrap_msc6_error_int", "race_wrap_msc7_error_int";

			power-domains = <&scmi_devpd 15>; /* R8A78000_SCMI_PD_RSW */
			clocks = <&scmi_clk 320>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3 */
				 <&scmi_clk 321>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3TSN */
				 <&scmi_clk 322>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3AES */
				 <&scmi_clk 323>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3TSNTES0 */
				 <&scmi_clk 324>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3TSNTES1 */
				 <&scmi_clk 325>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3TSNTES2 */
				 <&scmi_clk 326>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3TSNTES3 */
				 <&scmi_clk 327>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3TSNTES4 */
				 <&scmi_clk 328>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3TSNTES5 */
				 <&scmi_clk 329>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3TSNTES6 */
				 <&scmi_clk 330>, /* R8A78000_SCMI_CLOCK_MDLC_RSW3TSNTES7 */
				 <&scmi_clk 331>; /* R8A78000_SCMI_CLOCK_MDLC_RSW3MFWD */
			clock-names = "rsw3", "rsw3tsn", "rsw3aes",
				      "rsw3tsntes0", "rsw3tsntes1", "rsw3tsntes2",
				      "rsw3tsntes3", "rsw3tsntes4", "rsw3tsntes5",
				      "rsw3tsntes6", "rsw3tsntes7", "rsw3mfwd";
