/dts-v1/;
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/soc/renesas,r8a78000-mfis.h>
#include <dt-bindings/net/ti-dp83869.h>
#include "r8a78000.dtsi"

/ {
	model = "Renesas Ironhide board based on r8a78000";
	compatible = "renesas,ironhide", "renesas,r8a78000";

	aliases {
		serial0 = &hscif0;
		serial1 = &hscif1;
		serial2 = &scif0;	// FIXME
		serial3 = &scif1;	// FIXME
	};

	chosen {
		stdout-path = "serial0:1843200n8";
	};

	firmware {
		scmi: scmi {
			compatible = "arm,scmi";
			mboxes = <&mfis_scp 2 MFIS_CHANNEL_TX>,
				 <&mfis_scp 2 MFIS_CHANNEL_RX>;
			mbox-names = "tx", "rx";
			shmem = <&scmi_tx_shmem>, <&scmi_rx_shmem>;
			arm,no-completion-irq;
			#address-cells = <1>;
			#size-cells = <0>;

			scmi_devpd: protocol@11 {
				reg = <0x11>;
				#power-domain-cells = <1>;
			};

			scmi_sys: protocol@12 {
				reg = <0x12>;
			};

			scmi_clk: protocol@14 {
				reg = <0x14>;
				#clock-cells = <1>;
			};

			scmi_reset: protocol@16 {
				reg = <0x16>;
				#reset-cells = <1>;
			};
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x80000000>;
	};

	memory@1080000000 {
		device_type = "memory";
		reg = <0x10 0x80000000 0x0 0x80000000>;
	};

	memory@1200000000 {
		device_type = "memory";
		reg = <0x12 0x00000000 0x1 0x00000000>;
	};

	memory@1400000000 {
		device_type = "memory";
		reg = <0x14 0x00000000 0x1 0x00000000>;
	};

	memory@1600000000 {
		device_type = "memory";
		reg = <0x16 0x00000000 0x1 0x00000000>;
	};

	memory@1800000000 {
		device_type = "memory";
		reg = <0x18 0x00000000 0x1 0x00000000>;
	};

	memory@1a00000000 {
		device_type = "memory";
		reg = <0x1a 0x00000000 0x1 0x00000000>;
	};

	memory@1c00000000 {
		device_type = "memory";
		reg = <0x1c 0x00000000 0x1 0x00000000>;
	};

	memory@1e00000000 {
		device_type = "memory";
		reg = <0x1e 0x00000000 0x1 0x00000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* First 518 MiB is reserved for other purposes. */
		firmware@40000000 {
			reg = <0x0 0x40000000 0x0 0x20600000>;
			no-map;
		};

		/* Parameters set by IPL. */
		parameters@8c100000 {
			reg = <0x0 0x8c100000 0x0 0x00008000>;
			no-map;
		};

		/* TFA BL31. */
		tfa-bl31@8c200000 {
			reg = <0x0 0x8c200000 0x0 0x00080000>;
			no-map;
		};

		/* TEE TZ DRAM. */
		tee@8c400000 {
			reg = <0x0 0x8c400000 0x0 0x02000000>;
			no-map;
		};

		/* DRAM controller inline ECC areas */
		ecc@10cccc0000 {
			reg = <0x10 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@12cccc0000 {
			reg = <0x12 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@14cccc0000 {
			reg = <0x14 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@16cccc0000 {
			reg = <0x16 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@18cccc0000 {
			reg = <0x18 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@1a66660000 {
			reg = <0x1a 0x66660000 0x0 0x999a0000>;
			no-map;
		};

		ecc@1c66660000 {
			reg = <0x1c 0x66660000 0x0 0x999a0000>;
			no-map;
		};

		ecc@1e66660000 {
			reg = <0x1e 0x66660000 0x0 0x999a0000>;
			no-map;
		};
	};

	mailbox_test_send_to_recv {
		compatible = "mailbox-test";
		reg = <0x0 0xc1000000 0x0 0x100>;
		mboxes = <&mfis 0 (MFIS_CHANNEL_IICR | MFIS_CHANNEL_TX)>,
			 <&mfis 0 (MFIS_CHANNEL_EICR | MFIS_CHANNEL_RX)>;
		mbox-names = "tx", "rx";
	 };

	mailbox_test_recv_to_send {
		compatible = "mailbox-test";
		reg = <0x0 0xc1000100 0x0 0x100>;
		mboxes = <&mfis 0 (MFIS_CHANNEL_EICR | MFIS_CHANNEL_TX)>,
			 <&mfis 0 (MFIS_CHANNEL_IICR | MFIS_CHANNEL_RX)>;
		mbox-names = "tx", "rx";
	 };
};

&cpg {
	firmware = <&scmi>;
};

&extal_clk {
	clock-frequency = <16666600>;
};

&extalr_clk {
	clock-frequency = <32768>;
};

&hscif0 {
	pinctrl-0 = <&hscif0_pins>;
	pinctrl-names = "default";

	uart-has-rtscts;
	status = "okay";
};

&hscif1 {
	pinctrl-0 = <&hscif1_pins>;
	pinctrl-names = "default";

	uart-has-rtscts;
	status = "okay";
};

&mdlc_aon {
	firmware = <&scmi>;
};

&mdlc_cmnn {
	firmware = <&scmi>;
};

&mdlc_cmns {
	firmware = <&scmi>;
};

&mdlc_ddr0 {
	firmware = <&scmi>;
};

&mdlc_ddr1 {
	firmware = <&scmi>;
};

&mdlc_ddr2 {
	firmware = <&scmi>;
};

&mdlc_ddr3 {
	firmware = <&scmi>;
};

&mdlc_ddr4 {
	firmware = <&scmi>;
};

&mdlc_ddr5 {
	firmware = <&scmi>;
};

&mdlc_ddr6 {
	firmware = <&scmi>;
};

&mdlc_ddr7 {
	firmware = <&scmi>;
};

&mdlc_dsp {
	firmware = <&scmi>;
};

&mdlc_gpc {
	firmware = <&scmi>;
};

&mdlc_hscn {
	firmware = <&scmi>;
};

&mdlc_hscs {
	firmware = <&scmi>;
};

&mdlc_imn {
	firmware = <&scmi>;
};

&mdlc_ims {
	firmware = <&scmi>;
};

&mdlc_mm {
	firmware = <&scmi>;
};

&mdlc_npu0 {
	firmware = <&scmi>;
};

&mdlc_npu1 {
	firmware = <&scmi>;
};

&mdlc_pere {
	firmware = <&scmi>;
};

&mdlc_perw {
	firmware = <&scmi>;
};

&mdlc_rt {
	firmware = <&scmi>;
};

&mdlc_scp {
	firmware = <&scmi>;
};

&mdlc_top {
	firmware = <&scmi>;
};

&mdlc_vio {
	firmware = <&scmi>;
};

&mdlc_vipn {
	firmware = <&scmi>;
};

&mdlc_vips {
	firmware = <&scmi>;
};

&mfis {
	status = "okay";
};

&mfis_scp {
	status = "okay";
};

&gpio10 {
	pcie40-clkreq-hog {
		gpio-hog;
		gpios = <12 1>;
		output-high;
	};
};

&mp_phy {
	renesas,num-lanes = <4 4 0 0>;
	renesas,phy-type = <PHY_TYPE_PCIE 0>, <PHY_TYPE_PCIE 0>,
			   <PHY_TYPE_XPCS 2>, <PHY_TYPE_USB3 1>;
	renesas,external-ref-clock = <1 1 1 1>;
	renesas,output-repeat-ref-clock = <0 0 0 0>;
	status = "okay";
};

&pcie40_clkref {
	clock-frequency = <100000000>;
};

&pciec40 {
	status = "okay";
};

&pciec40_rp {
	resets = <&scmi_reset 815>; /* R8A78000_SCMI_RESET_U266_PCIE4 */
	reset-names = "perst";
};

&pfc {
	pinctrl-0 = <&scif_clk_pins>;
	pinctrl-names = "default";

	hscif0_pins: hscif0 {
		groups = "hscif0_data", "hscif0_ctrl";
		function = "hscif0";
	};

	hscif1_pins: hscif1 {
		groups = "hscif1_data", "hscif1_ctrl";
		function = "hscif1";
	};

	scif0_pins: scif0 {
		groups = "scif0_data", "scif0_ctrl";
		function = "scif0";
	};

	scif1_pins: scif1 {
		groups = "scif1_data", "scif1_ctrl";
		function = "scif1";
	};

	scif_clk_pins: scif-clk {
		groups = "scif_clk";
		function = "scif_clk";
	};
};

&scif_clk {
	clock-frequency = <26000000>;
};

&scif0 {
	pinctrl-0 = <&scif0_pins>;
	pinctrl-names = "default";

	uart-has-rtscts;
	//status = "okay";	// FIXME Mutually-exclusive with hscif0
};

&scif1 {
	pinctrl-0 = <&scif1_pins>;
	pinctrl-names = "default";

	uart-has-rtscts;
	//status = "okay";	// FIXME Mutually-exclusive with hscif1
};

&stcm_transport {
	scmi_tx_shmem: sram@1200 {
		compatible = "arm,scmi-shmem";
		reg = <0x1200 0x0100>;
	};

	scmi_rx_shmem: sram@1300 {
		compatible = "arm,scmi-shmem";
		reg = <0x1300 0x100>;
	};
};

&ufs1_ref_clk {
	clock-frequency = <52000000>;
};

&ufs1 {
	status = "okay";
};

&pfc {
	eth25g2_pins: eth25g2 {
		groups = "eth25g2_mdio", "eth25g2_link", "eth25g2_phyint";
		function = "eth25g2";
		drive-strength = <24>;
	};

	ethes0_pins: ethes0 {
		groups = "ethes0_match", "ethes0_capture", "ethes0_pps";
		function = "ethes0";
		drive-strength = <24>;
	};

	rsw3_pins: rsw3 {
		groups = "rsw3_match", "rsw3_capture", "rsw3_pps";
		function = "rsw3";
		drive-strength = <24>;
	};

	usb30_pins: usb0 {
		//groups = "usb0_vbus", "usb0";
		//function = "usb0";
		mux {
			groups = "usb0_vbus", "usb0";
			function = "usb0";
		};

		ovc {
			pins = "GP_10_1";
			bias-pull-down;
		};

		pwen {
			pins = "GP_10_0";
			bias-pull-up;
		};

		vbus {
			pins = "GP_10_2";
			bias-pull-up;
		};
	};

	usb20_pins: usb1 {
		//groups = "usb1_vbus", "usb1";
		//function = "usb1";
		mux {
			groups = "usb1_vbus", "usb1";
			function = "usb1";
		};

		ovc {
			pins = "GP_10_4";
			bias-pull-down;
		};

		pwen {
			pins = "GP_10_3";
			bias-pull-up;
		};

		vbus {
			pins = "GP_10_5";
			bias-pull-up;
		};
	};

	usb31_pins: usb2 {
		//groups = "usb2_vbus", "usb2";
		//function = "usb2";
		mux {
			groups = "usb2_vbus", "usb2";
			function = "usb2";
		};

		ovc {
			pins = "GP_10_7";
			bias-pull-down;
		};

		pwen {
			pins = "GP_10_6";
			bias-pull-up;
		};

		vbus {
			pins = "GP_10_8";
			bias-pull-up;
		};
	};

	usb21_pins: usb3 {
		//groups = "usb3_vbus", "usb3";
		//function = "usb3";
		mux {
			groups = "usb3_vbus", "usb3";
			function = "usb3";
		};

		ovc {
			pins = "GP_10_10";
			bias-pull-down;
		};

		pwen {
			pins = "GP_10_9";
			bias-pull-up;
		};

		vbus {
			pins = "GP_10_11";
			bias-pull-up;
		};
	};
};

&eth_pcs {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@4 {
			reg = <4>;
			phys = <&mp_phy 2 0>;
		};

		port@5 {
			reg = <5>;
			phys = <&mp_phy 2 1>;
		};
	};
};

&rsw3_clk {
	clock-frequency = <66660000>;
};

&rswitch3 {
	status = "okay";
	pinctrl-0 = <&eth25g2_pins>, <&ethes0_pins>;
	pinctrl-names = "default";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		// TODO: Add more ports (e.g., port@0, port@1) as needed
		port@4 {
			reg = <4>;
			renesas,etha-mii-chan = <4>;
			phy-handle = <&q32xx_phy>;
			phy-mode = "usxgmii";
			phys = <&eth_pcs 4>;
			max-speed = <10000>;

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;
				q32xx_phy: ethernet-phy@1 {
					reg = <1>;
					compatible = "ethernet-phy-ieee802.3-c45";
				};
			};
		};

		port@5 {
			reg = <5>;
			renesas,etha-mii-chan = <4>;
			renesas,connect_to_xpcs;
			phy-handle = <&dp83869_phy>;
			phy-mode = "sgmii";
			phys = <&eth_pcs 5>;

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;
				dp83869_phy: ethernet-phy@2 {
					reg = <2>;
					ti,sgmii-interface;
					ti,max-output-impedance;
					ti,refclk-output-enable;
					ti,clk-output-sel = <DP83869_CLK_O_SEL_REF_CLK>;
				};
			};
		};

		/* Example stub for future ports */
		//	port@5 {
		//	reg = <5>;
		//	phy-handle = <&mv_phy5>;
		//	phy-mode = "usxgmii";
		//	local-mac-address = [xx xx xx xx xx xx];
		//	phys = <&eth_pcs X>;
		//	...
		// };
	};
};

&tsnes3 {
	status = "okay";
};

&usb30 {
	status = "okay";
	pinctrl-0 = <&usb30_pins>;
	pinctrl-names = "default";
	phys = <&mp_phy 3 0>;
	phy-names = "usb3-phy";

	dwc3_usb30@c8800000 {
		compatible = "synopsys,dwc3";
		reg = <0x0 0xc8800000 0x0 0x100000>;
		interrupts = <GIC_SPI 795 IRQ_TYPE_LEVEL_HIGH>;
		maximum-speed = "high-speed";
		dr_mode = "host";
	};
};

&usb31 {
	status = "okay";
	pinctrl-0 = <&usb31_pins>;
	pinctrl-names = "default";
	phys = <&mp_phy 3 1>;
	phy-names = "usb3-phy";

	dwc3_usb31@c8a00000 {
		compatible = "synopsys,dwc3";
		reg = <0x0 0xc8a00000 0x0 0x100000>;
		interrupts = <GIC_SPI 797 IRQ_TYPE_LEVEL_HIGH>;
		maximum-speed = "super-speed-plus";
		dr_mode = "host";

		snps,host-vbus-glitches-quirk;
	};
};

&usb20 {
	status = "okay";
	pinctrl-0 = <&usb20_pins>;
	pinctrl-names = "default";

	dwc3_usb20@c8900000 {
		compatible = "synopsys,dwc3";
		reg = <0x0 0xc8900000 0x0 0x100000>;
		interrupts = <GIC_SPI 796 IRQ_TYPE_LEVEL_HIGH>;
		maximum-speed = "high-speed";
		dr_mode = "host";
	};
};

&usb21 {
	status = "okay";
	pinctrl-0 = <&usb21_pins>;
	pinctrl-names = "default";

	dwc3_usb21@c8b00000 {
		compatible = "synopsys,dwc3";
		reg = <0x0 0xc8b00000 0x0 0x100000>;
		interrupts = <GIC_SPI 798 IRQ_TYPE_LEVEL_HIGH>;
		maximum-speed = "high-speed";
		dr_mode = "host";
	};
};
